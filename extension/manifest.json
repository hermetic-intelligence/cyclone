{
  "manifest_version": 3,
  "name": "Cyclone DSA Capture",
  "version": "0.3.4",
  "minimum_chrome_version": "120",
  "description": "Capture LeetCode attempts, create local reports, and privately sync reports for feedback.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "offscreen", "downloads", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "https://*.leetcode.com/*", "https://huggingface.co/*", "https://*.hf.co/*", "https://dalyamgpwkllgwwfywpq.supabase.co/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Cyclone DSA Capture", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Start or stop a LeetCode capture"
    }
  },
  "content_scripts": [{
    "matches": ["https://leetcode.com/problems/*", "https://*.leetcode.com/problems/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
